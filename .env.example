# ==============================================================================
# PreDoc Enterprise AI - Environment Configuration (.env.example)
# Provider-Agnostic OpenAPI Specification Architecture
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Secret Storage & Rotation Architecture (Best Practices)
# ------------------------------------------------------------------------------
# Secrets can be loaded from three complementary tiers (highest priority first):
#   1. Container Runtime Secrets: /run/secrets/<secret_name> (Docker Swarm / K8s)
#   2. Host Work Secrets Store:   SECRETS_DIR or /mnt/data/work/work-secrets/<secret_name>[.txt]
#   3. Environment Variables:     Directly declared below in .env
#
# Custom directory for file-based host secrets (optional override):
SECRETS_DIR=/mnt/data/work/work-secrets

# ------------------------------------------------------------------------------
# 2. Primary OpenAPI Spec Endpoint (e.g. NVIDIA NIM, vLLM, Ollama, OpenAI-compatible)
# ------------------------------------------------------------------------------
PRIMARY_API_BASE=https://integrate.api.nvidia.com/v1
PRIMARY_API_KEY=your_primary_api_key_here
PRIMARY_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
PRIMARY_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
PRIMARY_EMBEDDING_DIM=2048

# ------------------------------------------------------------------------------
# 3. Secondary / Fallback OpenAPI Spec Endpoint (Auto-failover on 429 / outage)
# ------------------------------------------------------------------------------
SECONDARY_API_BASE=https://openrouter.ai/api/v1
SECONDARY_API_KEY=your_secondary_api_key_here
SECONDARY_LLM_MODEL=liquid/lfm-2.5-2.6b:free
SECONDARY_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
SECONDARY_EMBEDDING_DIM=1024

# ------------------------------------------------------------------------------
# 4. Global Rate Limiter Settings (Strict single rate limiter across system)
# ------------------------------------------------------------------------------
GLOBAL_RATE_LIMIT_RPM=30
GLOBAL_RATE_LIMIT_RPD=50000

# ------------------------------------------------------------------------------
# 5. Per-Agent Specialized Model Allocation (Optional overrides)
# ------------------------------------------------------------------------------
AGENT_VALIDATION_MODEL=meta/llama-3.2-11b-vision-instruct
AGENT_CLASSIFIER_MODEL=meta/llama-3.2-11b-vision-instruct
AGENT_TRIAGE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AGENT_PROBING_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AGENT_POPULATOR_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AGENT_AUDITOR_MODEL=meta/llama-3.2-11b-vision-instruct

# ------------------------------------------------------------------------------
# 6. Security & Role-Based Authentication Credentials (RBAC)
# ------------------------------------------------------------------------------
# A. Clinician / User Role (Access to / Consultation UI & /api/chat consultations)
USER_USER=clinician
USER_PASS=clinician123
CLINICAL_API_KEY=your_secure_clinical_api_key_here

# Zero-Downtime Key Rotation: (Optional grace period for previously active key)
# Existing clients using this key remain authenticated during the migration window.
PREVIOUS_CLINICAL_API_KEY=your_previous_clinical_api_key_here

# B. Administrator Role (Access to /dashboard, /api/metrics, and full system management)
ADMIN_USER=admin
ADMIN_PASS=secure_admin_password_change_me
ADMIN_API_KEY=your_secure_admin_api_key_here

# ------------------------------------------------------------------------------
# 7. Server Network Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8010
